{
  "name": "driftguard-api",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 — internal HTTP API for DriftGuard. Boots Express, imports the engine from ../../src, exposes POST /api/checks and GET /api/runs.",
  "scripts": {
    "dev": "node -r tsconfig-paths/register -r ts-node/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}