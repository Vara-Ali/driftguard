# Copy this file to .env and fill in real values. .env is gitignored.

# GitHub personal access token (classic or fine-grained).
# Day 1 only needs read scope — it makes a single authenticated call to confirm
# auth is wired. Write scope is not needed until Day 6 (PR creation).
GITHUB_TOKEN=ghp_your_token_here

# --- Not used until Day 3 (LLM summarization). Safe to leave blank for now. ---
# MiniMax API key, same provider Recepta uses.
MINIMAX_API_KEY=

# --- Day 4 (codebase scanner) ---
# Absolute path to the codebase the scanner should search for usages of
# affected symbols. Defaults to the Recepta backend+bridge pair if unset
# in .env — override per-run via the RECEPTA_TARGET_PATH environment
# variable when scanning a different repo.
RECEPTA_TARGET_PATH=/mnt/c/Users/Vara/projects/business-brain/cohort-1-squad-siachen

# --- Day 6 (GitHub PR creation) ---
# Where --open-pr should open the PR. Defaults to Vara-Ali/driftguard,
# which is the disposable demo target. Override only when you have
# explicit permission from the repo owner.
GITHUB_REPO_OWNER=Vara-Ali
GITHUB_REPO_NAME=driftguard
# Base branch for the PR. Default 'main'.
GITHUB_REPO_BASE=main

# --- Phase 1 (SaaS build: Express server + Next.js dashboard) ---
# Port the internal API listens on. Used by apps/api/src/server.ts.
PORT=4000
# Allowed CORS origin for the dashboard dev server.
WEB_ORIGIN=http://localhost:3000

# --- Phase 2 (GitHub App auth + Supabase) ---
# Apply apps/api/src/db/schema.sql once on the Supabase project before
# starting the API. The connection string below uses the transaction-pooler
# endpoint (port 6543). Find it in: Supabase → Settings → Database →
# Connection string → URI tab.
SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<YOUR_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# GitHub App credentials — generated by the App's registration page.
# See docs/github-app-setup.md for the full walkthrough.
# App ID is shown on the App's "General" page after registration.
GITHUB_APP_ID=your_github_app_id
# Public OAuth client id (separate from App ID).
GITHUB_APP_CLIENT_ID=your_github_app_client_id
# OAuth client secret. Regenerate from the App's settings page if leaked.
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
# Private key (.pem contents). dotenv does not support real multi-line
# values — paste the .pem here with literal "\n" where newlines should go.
# The API server decodes "\n" back to real newlines at startup.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PEM_CONTENTS_HERE\n-----END RSA PRIVATE KEY-----"
# Optional. Only needed if you wire up webhooks.
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_or_unset
# Slug from the App's "Public link" (the part after github.com/apps/).
GITHUB_APP_SLUG=your-github-app-slug
